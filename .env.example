# Brand Sentinel Environment Configuration
# CodeTitan Hackathon 2026 | Team VAJRA

# Application Environment
NODE_ENV=development
PORT=5000

# Authentication & Cryptography
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=development_brand_sentinel_super_secret_jwt_key_2026

# Database Persistence
# Optional: Defaults to server/brand_sentinel.db in dev or /var/data/brand_sentinel.db in production
DATABASE_PATH=./brand_sentinel.db

# Google Gemini AI Integration (Optional)
# If provided, Brand Sentinel uses Gemini 1.5 Flash for nuanced semantic reasoning.
# If omitted, deterministic rule engine and offline semantic fallbacks are used.
GEMINI_API_KEY=

# SMTP Email Notification Service (Optional)
# Used for dispatching email alerts upon reviewer escalations.
# If omitted, notification records are persisted in the database and logged to console.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brand Sentinel Governance" <noreply@brandsentinel.internal>

